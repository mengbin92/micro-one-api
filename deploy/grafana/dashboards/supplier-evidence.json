{
  "uid": "supplier-evidence",
  "title": "Supplier Evidence and Weekly Review",
  "tags": [
    "micro-one-api",
    "billing",
    "supplier"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "description": "Coverage and unknown record counts. Missing metrics mean disabled or unobserved, not confirmed zero costs. Review original currency and report scope in the admin supplier report page.",
  "panels": [
    {
      "id": 1,
      "title": "Supplier coverage unavailable",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(micro_one_api_billing_vendor_report_monitor{state=\"unavailable\"})",
          "legendFormat": "unavailable"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No observation / disabled"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Reports awaiting evidence",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(micro_one_api_billing_vendor_report_monitor{state=\"pending\"})",
          "legendFormat": "pending"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No observation / disabled"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Reports needing review",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(micro_one_api_billing_vendor_report_monitor{state=\"attention\"})",
          "legendFormat": "attention"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No observation / disabled"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Unknown supplier amounts (records)",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(micro_one_api_billing_vendor_report_monitor{state=\"unknown\"})",
          "legendFormat": "unknown"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No observation / disabled"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Overdue evidence (72 hours)",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(micro_one_api_billing_vendor_report_monitor{state=\"overdue\"})",
          "legendFormat": "overdue"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No observation / disabled"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Notification delivery failure",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(micro_one_api_billing_vendor_report_monitor{state=\"notification_failed\"})",
          "legendFormat": "notification_failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No observation / disabled"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Supplier report coverage history (counts, not money)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (micro_one_api_billing_vendor_report_monitor)",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Operator task states (uncertain requires review)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind,state) (micro_one_api_operator_tasks)",
          "legendFormat": "{{kind}} {{state}}"
        }
      ]
    }
  ]
}
