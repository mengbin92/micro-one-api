# Copy to .env.minio.local (gitignored), chmod 0600. Use independent random
# credentials, e.g. openssl rand -hex 24. Never use the example placeholders.
# This image is built with deployments/docker/Dockerfile.backup-minio.
BACKUP_MINIO_IMAGE=micro-one-api/backup-minio:RELEASE.2025-10-15T17-29-55Z
BACKUP_MINIO_PORT=9000
MINIO_ROOT_USER=REPLACE_WITH_MINIO_ADMIN
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
BACKUP_S3_ACCESS_KEY=REPLACE_WITH_WORKER_ACCESS_KEY
BACKUP_S3_SECRET_KEY=REPLACE_WITH_RANDOM_WORKER_SECRET
BACKUP_S3_BUCKET=private-backups
BACKUP_S3_PREFIX=micro-one-api/production
BACKUP_S3_REGION=us-east-1
