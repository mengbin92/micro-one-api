# Install as /etc/micro-one-api/backup-worker.env, mode 0600, root-owned.
# Native host worker needs a private route to MySQL: use the container
# bridge IP, or a separately reviewed loopback-only published port. The
# standard Compose template does not publish MySQL; 127.0.0.1:3306 below is
# illustrative. Verify both DSNs reach the Compose server (UUID checked).
# Dedicated metadata account: SELECT/INSERT/UPDATE on the four backup_* tables.
BACKUP_CONTROL_DSN=backup_worker:REPLACE@tcp(127.0.0.1:3306)/oneapi_admin?parseTime=true
# Same MySQL server: SELECT, SHOW DATABASES and RELOAD/FLUSH_TABLES privileges.
# The Compose mysql container also needs its existing MYSQL_ROOT_PASSWORD.
BACKUP_SNAPSHOT_DSN=backup_snapshot:REPLACE@tcp(127.0.0.1:3306)/?parseTime=true
BACKUP_REDIS_PASSWORD=REPLACE
BACKUP_S3_ACCESS_KEY=REPLACE
BACKUP_S3_SECRET_KEY=REPLACE
