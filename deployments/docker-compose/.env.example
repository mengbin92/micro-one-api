# Required infrastructure
MYSQL_ROOT_PASSWORD=change-me
DATABASE_DSN=root:change-me@tcp(mysql:3306)/oneapi?charset=utf8mb4&parseTime=True&loc=Local
REDIS_PASSWORD=change-me

# Required service authentication
JWT_SECRET_KEY=change-me-to-a-long-random-string
CHANNEL_ENCRYPTION_KEY=change-me-channel-key-32-bytes!!
SERVICE_TOKEN=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me-to-a-long-random-string
GRAFANA_ADMIN_PASSWORD=change-me-to-a-long-random-string

# Proxy networks allowed to supply X-Forwarded-For. Keep the admin value empty
# when port 3000 is reached directly; set it to the ingress proxy subnet only.
IDENTITY_TRUSTED_PROXY_CIDRS=172.16.0.0/12
ADMIN_TRUSTED_PROXY_CIDRS=

# Optional orchestrator canary allowlist. Digest bearer tokens with HMAC-SHA256
# using SERVICE_TOKEN as the key; rotate/recompute this value with SERVICE_TOKEN.
RELAY_ORCHESTRATOR_TOKEN_HMAC_SHA256=

# Canonical usage billing rollout. Keep observe unless a completed production
# gate explicitly approves charge. In charge mode, entries are exact
# <subscription_account_id>:<upstream_model_id> pairs separated by commas;
# a missing/empty/invalid list fails safe to observe for every source. Use an
# explicit * only after the full-charge rollout is separately approved.
BILLING_CANONICAL_USAGE_MODE=observe
BILLING_CANONICAL_USAGE_CHARGE_ALLOWLIST=

# Browser Playground — use exact HTTPS console origins in production.
# Leave empty to reject browser cross-origin calls; do not use `*` in production.
CORS_ALLOWED_ORIGINS=https://console.example.com

# Initial admin bootstrap, first start only
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=

# Payment defaults
RECHARGE_AMOUNT_MULTIPLIER=10
PAYMENT_QUOTA_PER_UNIT=500000
ALIPAY_ENABLED=false
ALIPAY_FORM_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_APP_ID=
ALIPAY_CERT_DIR=../../cert/alipay
ALIPAY_PRIVATE_KEY=
ALIPAY_PRIVATE_KEY_PATH=/cert/alipay/application_private_key.pem
ALIPAY_PUBLIC_KEY=
ALIPAY_PUBLIC_KEY_PATH=/cert/alipay/alipay_public_key.pem
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
ALIPAY_APP_CERT_PATH=
ALIPAY_ROOT_CERT_PATH=
ALIPAY_PUBLIC_CERT_PATH=

# Channel health circuit breaker
CHANNEL_HEALTH_FAILURE_THRESHOLD=3
CHANNEL_HEALTH_COOLDOWN=5m
CHANNEL_HEALTH_CHECK_ENABLED=true
CHANNEL_HEALTH_CHECK_INTERVAL=5m
CHANNEL_HEALTH_CHECK_TIMEOUT=10s

# Channel health alerts (channel-service → notify-worker)
CHANNEL_HEALTH_ALERT_ENABLED=true
CHANNEL_HEALTH_ALERT_NOTIFY_TYPE=webhook
CHANNEL_HEALTH_ALERT_RECIPIENTS=[""]

# Reconciliation alerts
NOTIFY_GRPC_ENDPOINT=notify-worker:9008
RECON_ALERT_ENABLED=true
# For webhook/event alerts, set NOTIFY_WEBHOOK_URL and leave recipients empty,
# or set recipient URLs directly. For email alerts, use email addresses.
RECON_ALERT_NOTIFY_TYPE=email
RECON_ALERT_RECIPIENTS=["ops@example.com"]
RECON_ALERT_INTERVAL=1h
NOTIFY_WEBHOOK_URL=
# Alertmanager groups: webhook, event, email, wecom, dingtalk, feishu, or slack.
# For wecom, set NOTIFY_WECOM_WEBHOOK_URL to a robot key or full URL.
# For email, set ALERTMANAGER_EMAIL_RECIPIENT, NOTIFY_SMTP_HOST and NOTIFY_SMTP_FROM.
ALERTMANAGER_NOTIFY_TYPE=webhook
ALERTMANAGER_EMAIL_RECIPIENT=
NOTIFY_WECOM_WEBHOOK_URL=
NOTIFY_DINGTALK_WEBHOOK_URL=
NOTIFY_FEISHU_WEBHOOK_URL=
NOTIFY_SLACK_WEBHOOK_URL=
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASS=
NOTIFY_SMTP_FROM=
NOTIFY_DISPATCH_INTERVAL=30s
NOTIFY_DISPATCH_BATCH=20
NOTIFY_MAX_RETRY=3

# Routing groups v2: see docs/runbooks/routing-groups-runbook.md.
# Keep defaults until migrations, group/user backfills and capability checks pass.
# SUBSCRIPTION_ENTITLEMENTS_V2 is shared by admin, billing and relay.
CHANNEL_ROUTING_GROUP_DUAL_WRITE=false
IDENTITY_ROUTING_V2=false
IDENTITY_DEFAULT_ROUTING_GROUP=default
BILLING_REQUEST_SNAPSHOT_V2=false
SUBSCRIPTION_ENTITLEMENTS_V2=false
RELAY_ROUTING_CONTEXT_V2=false
RELAY_ROUTING_ORDERED=false
ADMIN_ROUTING_FIXED_KEYS=false
ADMIN_ROUTING_ORDERED_KEYS=false

# IAM service identities: independent opaque credentials, never SERVICE_TOKEN.
# Each process receives its own outbound token and only its needed inbound
# caller map. Leave blank while legacy; provision all before IAM cutover.
# Example CHANNEL_SERVICE_CALLER_TOKENS={"admin":"<admin token>","relay":"<relay token>","identity":"<identity token>","billing":"<billing token>","monitor":"<monitor token>","channel":"<channel token>"}
ADMIN_SERVICE_IDENTITY_TOKEN=
ADMIN_SERVICE_CALLER_TOKENS=
IDENTITY_SERVICE_IDENTITY_TOKEN=
IDENTITY_SERVICE_CALLER_TOKENS=
CHANNEL_SERVICE_IDENTITY_TOKEN=
CHANNEL_SERVICE_CALLER_TOKENS=
BILLING_SERVICE_IDENTITY_TOKEN=
BILLING_SERVICE_CALLER_TOKENS=
CONFIG_SERVICE_IDENTITY_TOKEN=
CONFIG_SERVICE_CALLER_TOKENS=
LOG_SERVICE_IDENTITY_TOKEN=
LOG_SERVICE_CALLER_TOKENS=
MONITOR_SERVICE_IDENTITY_TOKEN=
MONITOR_SERVICE_CALLER_TOKENS=
NOTIFY_SERVICE_IDENTITY_TOKEN=
NOTIFY_SERVICE_CALLER_TOKENS=
RELAY_SERVICE_IDENTITY_TOKEN=
RELAY_SERVICE_CALLER_TOKENS=

# D1 per-owner database channels. Unset values retain the legacy connection.
# Before cutover, provision least-privilege credentials and audit actual GRANTs.
IDENTITY_SQL_DSN=
ADMIN_SQL_DSN=
CHANNEL_SQL_DSN=
BILLING_SQL_DSN=
CONFIG_SQL_DSN=
LOG_SQL_DSN=
MONITOR_SQL_DSN=
NOTIFY_SQL_DSN=
RELAY_SQL_DSN=
# Explicit root rescue remains off; use an independent credential when enabled.
IAM_RESCUE_ENABLED=false
IAM_RESCUE_SERVICE_TOKEN=

# Subscription account reset/recovery scans (disabled by default).
SUBSCRIPTION_QUOTA_RESET_ENABLED=false
SUBSCRIPTION_QUOTA_RESET_INTERVAL=5m
SUBSCRIPTION_QUOTA_RESET_TIMEOUT=30s
SUBSCRIPTION_ACCOUNT_RECOVERY_ENABLED=false
SUBSCRIPTION_ACCOUNT_RECOVERY_INTERVAL=5m
SUBSCRIPTION_ACCOUNT_RECOVERY_TIMEOUT=30s
# All scan workers use the same count and distinct indexes in [0, count).
# Leave index empty for the single-worker default; required when count > 1.
SUBSCRIPTION_ACCOUNT_OPS_SHARD_COUNT=1
SUBSCRIPTION_ACCOUNT_OPS_SHARD_INDEX=
# Optional scan-only worker profile: primary index=0, worker index=1, count=2.
# Explicitly enable the profile; this process has health/metrics only.
SUBSCRIPTION_ACCOUNT_OPS_WORKER_SHARD_INDEX=1
