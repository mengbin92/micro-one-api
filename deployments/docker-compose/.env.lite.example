# Lite deployment environment (SQLite3, no MySQL container).
# Copy to .env and edit the values marked REQUIRED. All other values are
# safe to leave at their defaults for a single-host deployment.

# Database — SQLite3 file. The volume `sqlite_data` (declared in
# docker-compose.lite.yml) is mounted at /data, so the file lives there
# across container restarts.
DATABASE_DRIVER=sqlite3
DATABASE_DSN=file:/data/micro-one-api.db?_busy_timeout=5000&_journal_mode=WAL&_foreign_keys=on

# Local-only listeners by default. Set a reachable bind address deliberately
# when serving other machines (use HTTPS / reverse proxy for public access).
LITE_BIND_ADDRESS=127.0.0.1
LITE_ADMIN_PORT=3000
LITE_RELAY_PORT=8080

# Redis password is REQUIRED by Compose.
REDIS_PASSWORD=change-me

# Service authentication — REQUIRED.
JWT_SECRET_KEY=change-me-to-a-long-random-string
# Generate a unique 32-byte ASCII key using docs/quickstart-lite.md before startup.
CHANNEL_ENCRYPTION_KEY=
SERVICE_TOKEN=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me-to-a-long-random-string
IDENTITY_TRUSTED_PROXY_CIDRS=172.16.0.0/12
ADMIN_TRUSTED_PROXY_CIDRS=

# Canonical usage billing remains in observe mode by default.
BILLING_CANONICAL_USAGE_MODE=observe
BILLING_CANONICAL_USAGE_CHARGE_ALLOWLIST=

# Browser Playground — use exact HTTPS console origins in production.
# Leave empty to reject browser cross-origin calls; do not use `*` in production.
CORS_ALLOWED_ORIGINS=

# Initial admin bootstrap, first start only. Leave PASSWORD empty to
# generate a random one in /data/initial-admin-password.txt (0600).
# Read it with: docker compose -f docker-compose.lite.yml exec identity-service \
#   cat /data/initial-admin-password.txt
# It is never printed to the service log.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=

# Payment defaults (mirrors the MySQL compose file).
RECHARGE_AMOUNT_MULTIPLIER=10
PAYMENT_QUOTA_PER_UNIT=500000
ALIPAY_ENABLED=false
ALIPAY_FORM_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_APP_ID=
ALIPAY_CERT_DIR=../../cert/alipay
ALIPAY_PRIVATE_KEY=
ALIPAY_PRIVATE_KEY_PATH=/cert/alipay/application_private_key.pem
ALIPAY_PUBLIC_KEY=
ALIPAY_PUBLIC_KEY_PATH=/cert/alipay/alipay_public_key.pem
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
ALIPAY_APP_CERT_PATH=
ALIPAY_ROOT_CERT_PATH=
ALIPAY_PUBLIC_CERT_PATH=

# Channel health circuit breaker
CHANNEL_HEALTH_FAILURE_THRESHOLD=3
CHANNEL_HEALTH_COOLDOWN=5m
CHANNEL_HEALTH_CHECK_ENABLED=true
CHANNEL_HEALTH_CHECK_INTERVAL=5m
CHANNEL_HEALTH_CHECK_TIMEOUT=10s

# Channel health alerts
CHANNEL_HEALTH_ALERT_ENABLED=true
CHANNEL_HEALTH_ALERT_NOTIFY_TYPE=webhook
CHANNEL_HEALTH_ALERT_RECIPIENTS=[""]

# Reconciliation alerts
NOTIFY_GRPC_ENDPOINT=notify-worker:9008
RECON_ALERT_ENABLED=true
RECON_ALERT_NOTIFY_TYPE=email
RECON_ALERT_RECIPIENTS=["ops@example.com"]
RECON_ALERT_INTERVAL=1h
NOTIFY_WEBHOOK_URL=
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASS=
NOTIFY_SMTP_FROM=
NOTIFY_DISPATCH_INTERVAL=30s
NOTIFY_DISPATCH_BATCH=20
NOTIFY_MAX_RETRY=3
